DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL (leave DB_NAME empty to fall back to SQLite for quick local runs)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Comma-separated Google OAuth client IDs (Android + Web client) accepted as token audience
GOOGLE_OAUTH_CLIENT_IDS=

TRANSCRIPTION_PROVIDER=none
WHISPER_MODEL=base
